{
    "containerDefinitions": [
        {
            "name": "book-pilots-backend",
            "image": "118407775209.dkr.ecr.us-west-2.amazonaws.com/book-pilots-backend:latest",
            "cpu": 0,
            "portMappings": [
                {
                    "containerPort": 8000,
                    "hostPort": 8000,
                    "protocol": "tcp",
                    "name": "book-pilots-backend-8000-tcp",
                    "appProtocol": "http"
                }
            ],
            "essential": true,
            "environment": [
                {
                    "name": "REFRESH_TOKEN_EXPIRE_DAYS",
                    "value": "7"
                },
                {
                    "name": "ACCESS_TOKEN_EXPIRE_MINUTES",
                    "value": "30"
                },
                {
                    "name": "JWT_ALGORITHM",
                    "value": "HS256"
                },
                {
                    "name": "RECOMMENDER_MIN_RATINGS",
                    "value": "3"
                },
                {
                    "name": "FRONTEND_URL",
                    "value": "https://bookpilotsapp.com"
                }
            ],
            "environmentFiles": [],
            "mountPoints": [],
            "volumesFrom": [],
            "secrets": [
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "arn:aws:secretsmanager:us-west-2:118407775209:secret:book-pilots/database-url-OyFJDI:DATABASE_URL::"
                },
                {
                    "name": "JWT_SECRET_KEY",
                    "valueFrom": "arn:aws:secretsmanager:us-west-2:118407775209:secret:book-pilots/jwt-secret-V887ra"
                }
            ],
            "ulimits": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/book-pilots-backend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-west-2",
                    "awslogs-stream-prefix": "ecs"
                },
                "secretOptions": []
            },
            "systemControls": []
        }
    ],
    "family": "book-pilots-backend",
    "executionRoleArn": "arn:aws:iam::118407775209:role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "volumes": [],
   
    "placementConstraints": [],

    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512"
    
 }
